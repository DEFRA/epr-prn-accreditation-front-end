@model ExemptionReferencesViewModel

@{
    ViewData["Title"] = ExemptionReferencesResources.PageTitle;
}

<partial name="_ValidationSummary" />
<form method="post">
    <h1 class="govuk-heading-l">@ExemptionReferencesResources.PageHeading</h1>
    <p class="govuk-body">@ExemptionReferencesResources.P1</p>


    @for (int i = 0; i < 5; i++)
    {
        var value = Model.ExemptionReferencesVm.Count > i ? Model.ExemptionReferencesVm[i].Reference : string.Empty;

        <p class="govuk-error-message">
            <span asp-validation-for="@value"></span>
        </p>
        <div class="govuk-form-group">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full">
                    <input class="govuk-input govuk-input--width-30" type="text" asp-for="@Model.ExemptionReferencesVm[i].Reference" data-clear-duplicate='true'>
                </div>
            </div>
        </div>
    }
    <partial name="_SaveButtons" />
</form>