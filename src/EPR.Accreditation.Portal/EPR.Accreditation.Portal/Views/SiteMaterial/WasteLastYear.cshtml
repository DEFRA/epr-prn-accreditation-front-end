@model ReprocessedWasteLastYearViewModel
@using EPR.Accreditation.Portal.Enums
@using EPR.Accreditation.Portal.ViewModels
@using EPR.Accreditation.Portal.Resources
@using EPR.Accreditation.Portal.Helpers.TagHelpers
@using EPR.Accreditation.Portal.ViewModels.SiteMaterial

@{
    ViewData["Title"] = WasteLastYearResources.PageTitle;
}

<partial name="_ValidationSummary" />
<form method="post">
    <radios asp-for="HasReprocessedWasteLastYear" asp-title="@WasteLastYearResources.PageHeading">
        <p class="govuk-error-message">
            <span asp-validation-for="HasReprocessedWasteLastYear"></span>
        </p>
        <div class="govuk-radios__item">
            <input class="govuk-radios__input" type="radio" id="a" asp-for="HasReprocessedWasteLastYear" value="@true" aria-describedby="@MasterResources.Yes">
            <label class="govuk-label govuk-radios__label" for="@MasterResources.Yes">
                @MasterResources.Yes
            </label>
        </div>
        <div class="govuk-radios__item">
            <input class="govuk-radios__input" type="radio" id="b" asp-for="HasReprocessedWasteLastYear" value="@false" aria-describedby="@MasterResources.No">
            <label class="govuk-label govuk-radios__label" for="@MasterResources.No">
                @MasterResources.No
            </label>
        </div>
    </radios>
    <partial name="_SaveButtons" />
</form>