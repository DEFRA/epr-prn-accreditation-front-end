@using EPR.Accreditation.Portal.Helpers.TagHelpers
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model EPR.Accreditation.Portal.ViewModels.CheckAnswers.CheckAnswersViewModel

@{
    ViewData["Title"] = CheckYourAnswersResources.Title;
}

<partial name="_ValidationSummary" />

<form method="post">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds-from-desktop">

            <h1 class="govuk-heading-l">@CheckYourAnswersResources.Title</h1>
            <p class="govuk-hint">@CheckYourAnswersResources.Hint</p>

            <dl class="govuk-summary-list govuk-!-margin-bottom-9">
	            @foreach (var row in Model.SectionRows)
	            {
		            @await Html.PartialAsync("_CheckAnswersSection", row)
	            }
            </dl>

            <input type="hidden" value="@Model.Id" />
            <input type="hidden" asp-for="@Model.Completed" />
            <button class="govuk-button" data-module="govuk-button">
                @MasterResources.ConfirmAndContinue
            </button>

        </div>
    </div>
</form>

