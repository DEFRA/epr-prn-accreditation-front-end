@model CompletionViewModel
@using EPR.Accreditation.Portal.Enums
@using EPR.Accreditation.Portal.ViewModels
@using EPR.Accreditation.Portal.Resources
@using EPR.Accreditation.Portal.Helpers.TagHelpers

@{
    ViewData["Title"] = CompletionResources.PageTitle;
}

<partial name="_ValidationSummary" />

    <div class="govuk-grid-row">
        <div class="govuk-grid-column">
            <p class="govuk-body">
                <a href="/" class="govuk-back-link">@MasterResources.BackLink</a>
            </p>

            <div class="govuk-grid-row">
                
                <div class="govuk-grid-column-full">

                <div class="govuk-panel govuk-panel--confirmation">
                    <h1 class="govuk-panel__title">
                        @CompletionResources.ApplicationSubmittedEngland
                    </h1>
                    <div class="govuk-panel__body">
                        @CompletionResources.ReferenceNumber<br><strong>HDJ2123F</strong>
                    </div>
                </div>

                <h4 class="govuk-heading-m">@CompletionResources.AmountDue</h4>
                <h4 class="govuk-heading-m">@CompletionResources.PayOnline</h4>
                <h4 class="govuk-heading-s">@CompletionResources.PayOnlineNotice</h4>
                <partial name="_BankDetails" />
                </div>

            </div>

        </div>
    </div>