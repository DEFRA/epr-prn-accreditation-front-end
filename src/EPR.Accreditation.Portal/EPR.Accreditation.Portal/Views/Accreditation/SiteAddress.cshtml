@using EPR.Accreditation.Portal.Resources;
@using EPR.Accreditation.Portal.ViewModels;

@model SiteAddressViewModel
@{
    ViewData["Title"] = SiteAddressResources.PageTitle;
}

<partial name="_ValidationSummary" />

<form method="post">
    <input id="Id" name="Id" type="hidden" value="@Model.Id"/>
    <input id="SiteId" name="SiteId" type="hidden" value="@Model.SiteId" />
    <input id="MaterialId" name="MaterialId" type="hidden" value="@Model.MaterialId" />
    <input id="OrganisationId" name="OrganisationId" type="hidden" value="@Model.OrganisationId" />

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">@SiteAddressResources.Heading</h1>
            <fieldset class="govuk-fieldset">
                
                <div class="govuk-form-group">
                    <p class="govuk-error-message">
                        <span asp-validation-for="Address1"></span>
                    </p>
                    <h2 class="govuk-label-wrapper">
                        <label class="govuk-label govuk-label--s" for="Address1">
                            @SiteAddressResources.AddressLine1
                        </label>
                    </h2>
                    <input class="govuk-input" asp-for="Address1" value="@Model.Address1" type="text" aria-describedby="Address1-hint">
                </div>

                <div class="govuk-form-group">
                    <p class="govuk-error-message">
                        <span asp-validation-for="Address2"></span>
                    </p>
                    <h2 class="govuk-label-wrapper">
                        <label class="govuk-label govuk-label--s" for="Address2">
                            @SiteAddressResources.AddressLine2
                        </label>
                    </h2>
                    <input class="govuk-input" asp-for="Address2" value="@Model.Address2" type="text" aria-describedby="AddressLine2-hint">
                </div>

                <div class="govuk-form-group">
                    <p class="govuk-error-message">
                        <span asp-validation-for="Town"></span>
                    </p>
                    <h2 class="govuk-label-wrapper">
                        <label class="govuk-label govuk-label--s" for="Town">
                            @SiteAddressResources.TownOrCity
                        </label>
                    </h2>
                    <input class="govuk-input" asp-for="Town" value="@Model.Town" type="text" aria-describedby="TownOrCity-hint">
                </div>

                <div class="govuk-form-group">
                    <p class="govuk-error-message">
                        <span asp-validation-for="County"></span>
                    </p>
                    <h2 class="govuk-label-wrapper">
                        <label class="govuk-label govuk-label--s" for="County">
                            @SiteAddressResources.County
                        </label>
                    </h2>
                    <input class="govuk-input" asp-for="County" value="@Model.County" type="text" aria-describedby="County-hint">
                </div>

                <div class="govuk-form-group">
                    <p class="govuk-error-message">
                        <span asp-validation-for="Postcode"></span>
                    </p>
                    <h2 class="govuk-label-wrapper">
                        <label class="govuk-label govuk-label--s" for="Postcode">
                            @SiteAddressResources.PostCode
                        </label>
                    </h2>
                    <input class="govuk-input" asp-for="Postcode" value="@Model.Postcode" type="text" aria-describedby="PostCode-hint">
                </div>

                <partial name="_SaveButtons" />
            </fieldset>
        </div>
    </div>
</form>
