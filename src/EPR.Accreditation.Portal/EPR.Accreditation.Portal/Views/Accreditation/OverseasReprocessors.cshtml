@using EPR.Accreditation.Portal.ViewModels.Accreditation
@using Microsoft.AspNetCore.Mvc.Routing;
@model OverseasReprocessorViewModel;
@{
    ViewData["Title"] = OverseasReprocessorResources.PageTitle;
}

<partial name="_ValidationSummary" />
<form method="post">
    <radios asp-for=AddOverseasReprocessor asp-title=@OverseasReprocessorResources.PageTitle>

        <p class="govuk-error-message">
            <span asp-validation-for="AddOverseasReprocessor"></span>
        </p>
        <div>
            <p class="govuk-hint">@OverseasReprocessorResources.Hint1</p>
            <p class="govuk-hint">@OverseasReprocessorResources.Hint2</p>
        </div>
        <div class="govuk-radios__item">
            <input class="govuk-radios__input" type="radio" asp-for="AddOverseasReprocessor" value="@true" aria-describedby="@MasterResources.Yes">
            <label class="govuk-label govuk-radios__label" for="@MasterResources.Yes">
                @MasterResources.Yes
            </label>
        </div>
        <div class="govuk-radios__item">
            <input class="govuk-radios__input" type="radio" asp-for="AddOverseasReprocessor" value="@false" aria-describedby="@MasterResources.No">
            <label class="govuk-label govuk-radios__label" for="@MasterResources.No">
                @OverseasReprocessorResources.NoText
            </label>
        </div>
    </radios>
    <partial name="_SaveButtons" />
</form>