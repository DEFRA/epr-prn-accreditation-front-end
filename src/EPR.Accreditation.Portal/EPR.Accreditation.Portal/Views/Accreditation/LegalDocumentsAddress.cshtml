@model LegalDocumentsAddressViewModel

@{
    ViewData["Title"] = LegalDocumentsAddressResources.PageTitle;
}

<partial name="_ValidationSummary" />

<form method="post">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">@LegalDocumentsAddressResources.PageTitle</h1>
            <p class="govuk-body">@LegalDocumentsAddressResources.Subtitle</p>
            <partial name="_Address" model="Model"></partial>
            <partial name="_SaveButtons" />
        </div>
    </div>
</form>
