@model List<EPR.Accreditation.Portal.ViewModels.Files.FileUploadRecordViewModel>

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Uploaded files</th>
            <th scope="col" class="govuk-table__header">Date uploaded</th>
            <th scope="col" class="govuk-table__header">Uploaded by</th>
            <th scope="col" class="govuk-table__header"></th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach(var file in Model)
        {
            <tr class="govuk-table__row">
                <td class ="govuk-table__cell">
                    <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("View","Files", new { id = "3FA85F64-5717-4562-B3FC-2C963F66AFA6", fileId = file.FileId })">@file.Filename</a>
                </td>
                <td class="govuk-table__cell">@file.DateUploaded.ToString("dd/MM/yy")</td>
                <td class="govuk-table__cell">@file.UploadedBy</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Delete","Files", new { id = "3FA85F64-5717-4562-B3FC-2C963F66AFA6", fileId = file.FileId })">@MasterResources.Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>