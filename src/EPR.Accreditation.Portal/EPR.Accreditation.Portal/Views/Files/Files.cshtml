@model EPR.Accreditation.Portal.ViewModels.Files.FileUploadRecordsViewModel

<div class="govuk-width-container ">

    <partial name="_ValidationSummary" />

    <main class="govuk-main-wrapper govuk-!-padding-top-4" id="main-content" role="main">

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-three-quarters">


                    <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset" aria-describedby="waste-hint">

                            <h1 class="govuk-heading-l govuk-!-margin-top-4 govuk-!-margin-bottom-7">
                                @FileUploadResources.Title
                            </h1>

                            <div class="govuk-body-m">
                                <p>@FileUploadResources.Hint_Header</p>
                                <li>@FileUploadResources.Hint_Item1</li>
                                <li>@FileUploadResources.Hint_Item2</li>
                                <li>@FileUploadResources.Hint_Item3</li>
                            </div>

                            <table class="govuk-table">
                                <thead class="govuk-table__head">
                                    <tr class="govuk-table__row">
                                        <th scope="col" class="govuk-table__header">@FileUploadResources.FlowChart_Title </th>
                                        <th scope="col" class="govuk-table__header"></th>
                                        <th scope="col" class="govuk-table__header">  </th>
                                    </tr>
                                </thead>
                            </table>
                            @Html.Partial("_fileUploadButton")
                            <br>
                            <br>
                            @* @Html.Partial("_fileUploadedList", Model.FlowCharts) *@
                            @if (Model.FlowCharts.Any())
                            {
                                <partial name="_fileUploadedList" for="FlowCharts" view-data="ViewData" />
                            }

                            <table class="govuk-table">

                                <thead class="govuk-table__head">
                                    <tr class="govuk-table__row">
                                        <th scope="col" class="govuk-table__header">@FileUploadResources.RecordingSystems_Title </th>
                                        <th scope="col" class="govuk-table__header"></th>

                                        <th scope="col" class="govuk-table__header">  </th>

                                    </tr>
                                </thead>

                            </table>
                            @Html.Partial("_fileUploadButton")
                            <br>
                            <br>
                            @if (Model.RecordingSystems.Any())
                            {
                                <partial name="_fileUploadedList" for="RecordingSystems" view-data="ViewData" />
                            }

                            <table class="govuk-table">

                                <thead class="govuk-table__head">
                                    <tr class="govuk-table__row">
                                        <th scope="col" class="govuk-table__header">@FileUploadResources.PlantsAndEquipment_Title </th>
                                        <th scope="col" class="govuk-table__header"></th>

                                        <th scope="col" class="govuk-table__header">  </th>

                                    </tr>
                                </thead>

                            </table>
                            @Html.Partial("_fileUploadButton")
                            <br>
                            <br>
                            @* @Html.Partial("_fileUploadedList", Model.PlantsAndEquipments) *@
                            @if (Model.PlantsAndEquipments.Any())
                            {
                                <partial name="_fileUploadedList" for="PlantsAndEquipments" view-data="ViewData" />
                            }

                            <table class="govuk-table">

                                <thead class="govuk-table__head">
                                    <tr class="govuk-table__row">
                                        <th scope="col" class="govuk-table__header">@FileUploadResources.SamplingAndInspection_Title </th>
                                        <th scope="col" class="govuk-table__header"></th>

                                        <th scope="col" class="govuk-table__header">  </th>

                                    </tr>
                                </thead>

                            </table>
                            @Html.Partial("_fileUploadButton")
                            <br>
                            <br>
                            @* @Html.Partial("_fileUploadedList", Model.SamplingAndInspection) *@
                            @if (Model.SamplingAndInspection.Any())
                            {
                                <partial name="_fileUploadedList" for="SamplingAndInspection" view-data="ViewData" />
                            }
                        </fieldset>
                    </div>








                    <button class="govuk-button" data-module="govuk-button">
                        Upload file
                    </button>

                    <input type="hidden" value="@Model.AccreditationId" />
                    <button class="govuk-button" data-module="govuk-button">
                        @MasterResources.SaveAndContinue
                    </button>
                    <button class="govuk-button" data-module="govuk-button">
                        @MasterResources.SaveAndComeBack
                    </button>


            </div>
        </div>

    </main>
</div>

