@model ReprocessorDetailsViewModel

@{
    ViewData["Title"] = "Overseas reprocessor details";
}

<partial name="_ValidationSummary" />
<form method="post">
    <h1 class="govuk-heading-l">
        Overseas reprocessor details
    </h1>
    <div class="govuk-form-group">
        <label class="govuk-label" style="font-weight: bold">
            Organisation name
        </label>
        <input class="govuk-input govuk-!-width-two-thirds" type="text" asp-for="@Model.OrganisationName">
    </div>

    <div class="govuk-form-group">
        <label class="govuk-label" style="font-weight: bold" for="sort">
            Select country
        </label>
        <select class="govuk-select" id="sort" name="sort" asp-for="@Model.SelectedCountry">
            <option value="published" selected>Choose a country</option>
            @foreach(var country in Model.Countries)
            {
                <option value="@country">@country</option>
            }
        </select>
    </div>

    <div class="govuk-form-group">
        <label class="govuk-label" style="font-weight: bold" for="more-detail">
            Address
        </label>
        <textarea class="govuk-textarea govuk-!-width-two-thirds" id="address" name="address" rows="5" asp-for="@Model.Address"></textarea>
    </div>
    
    <partial name="_SaveButtons" />
</form>