@model AddressViewModel

<fieldset class="govuk-fieldset">

    <div class="govuk-form-group">
        <p class="govuk-error-message">
            <span asp-validation-for="Address1"></span>
        </p>
        <h2 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--s" for="Address1">
                @AddressResources.AddressLine1
            </label>
        </h2>
        <input class="govuk-input" asp-for="Address1" type="text" aria-describedby="Address1-hint">
    </div>

    <div class="govuk-form-group">
        <p class="govuk-error-message">
            <span asp-validation-for="Address2"></span>
        </p>
        <h2 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--s" for="Address2">
                @AddressResources.AddressLine2
            </label>
        </h2>
        <input class="govuk-input" asp-for="Address2" type="text" aria-describedby="AddressLine2-hint">
    </div>

    <div class="govuk-form-group">
        <p class="govuk-error-message">
            <span asp-validation-for="Town"></span>
        </p>
        <h2 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--s" for="Town">
                @AddressResources.TownOrCity
            </label>
        </h2>
        <input class="govuk-input" asp-for="Town" type="text" aria-describedby="TownOrCity-hint">
    </div>

    <div class="govuk-form-group">
        <p class="govuk-error-message">
            <span asp-validation-for="County"></span>
        </p>
        <h2 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--s" for="County">
                @AddressResources.County
            </label>
        </h2>
        <input class="govuk-input" asp-for="County" type="text" aria-describedby="County-hint">
    </div>

    <div class="govuk-form-group">
        <p class="govuk-error-message">
            <span asp-validation-for="Postcode"></span>
        </p>
        <h2 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--s" for="Postcode">
                @AddressResources.PostCode
            </label>
        </h2>
        <input class="govuk-input" asp-for="Postcode" type="text" aria-describedby="PostCode-hint">
    </div>
</fieldset>