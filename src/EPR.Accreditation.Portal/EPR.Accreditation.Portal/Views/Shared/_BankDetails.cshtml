@model EPR.Accreditation.Portal.ViewModels.CompletionViewModel

<div class="govuk-grid-row">


    @if (Model.CountryCode == "IRE")
    {
        <div class="govuk-panel govuk-panel--confirmation">
            <h1 class="govuk-panel__title">
                @CompletionResources.ApplicationSubmittedIreland
            </h1>
            <div class="govuk-panel__body">
                @CompletionResources.ReferenceNumber<br><strong>HDJ2123F</strong>
            </div>
        </div>

        <h4 class="govuk-heading-m">@CompletionResources.AfterPayment</h4>
        <h4 class="govuk-heading-m">@CompletionResources.AmountDue</h4>
        <h4 class="govuk-heading-m">£@Model.AmountDue</h4>
        <h4 class="govuk-heading-m">@CompletionResources.PayOnline</h4>

        <h4 class="govuk-heading-s">@CompletionResources.PayOnlineNotice</h4>

        <h4 class="govuk-heading-m">@CompletionResources.PayByBankTransfer</h4>
        <h4 class="govuk-heading-s">Use these details to make payment</h4>

        <table class="govuk-table">
            <tbody class="govuk-table__body">
            <tr class="govuk-table__row"><td><li>account name: DAERA</li></td></tr>
            <tr class="govuk-table__row"><td><li>bank: Danske bank. PO BOX 183 Donegail Square West. Belfast. BT1 6JS</li></td></tr>
            <tr class="govuk-table__row"><td><li>sort code: 95-01-21</li></td></tr>
            <tr class="govuk-table__row"><td><li>account number: 61253506</li></td></tr>
            <tr class="govuk-table__row"><td><li>BACS remittanace: billtocash@accountnl.gov.uk</li></td></tr>
        </table>

        <table class="govuk-table">
            <tr class="govuk-table__row">
                <td>
                    <details open>
                        <summary>Other ways to pay</summary>
                        <p>To discuss paying through other methods please contact Ireland Environment Agency</p>
                        <p>Email: packaging@environment-agency.gov.uk</p>
                        <p>Telephone: 028 9058 9338</p>
                    </details>
                </td>
            </tr>
        </table>
    }

